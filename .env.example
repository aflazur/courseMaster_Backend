# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/coursemaster

# Auth
JWT_SECRET=change_this_to_a_long_random_string
# Secret key a user must enter on the Register page to create an ADMIN account
ADMIN_REGISTRATION_KEY=change_this_admin_key

# Seeder (npm run seed) admin email
ADMIN_EMAIL=admin@coursemaster.com

# Optional: welcome email (leave empty to skip sending)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173
